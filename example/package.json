{
  "name": "expo-drafts-example",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.21",
    "expo-updates": "~57.0.21",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android --variant release --no-bundler",
    "ios": "expo run:ios --configuration Release --no-bundler",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "eas-build-pre-install": "npm ci --prefix .."
  },
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": ".."
    }
  }
}
