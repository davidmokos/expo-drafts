{
  "name": "expo-drafts",
  "version": "0.1.0",
  "description": "Switch between pull request previews powered by EAS Update",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "test": "node --test tests/*.test.mjs tests/cli/*.test.mjs",
    "prepare": "npm run build",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-drafts",
    "ExpoDrafts"
  ],
  "repository": "https://github.com/davidmokos/expo-drafts",
  "bugs": {
    "url": "https://github.com/davidmokos/expo-drafts/issues"
  },
  "author": "David Mokos <davidmokos@gmail.com> (https://github.com/davidmokos)",
  "license": "MIT",
  "homepage": "https://github.com/davidmokos/expo-drafts#readme",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.11",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "^57.0.21",
    "expo-updates": "~57.0.21",
    "prettier": "^3.0.0",
    "react": "^19.2.3",
    "react-native": "^0.86.3",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "expo": ">=57.0.0 <58.0.0",
    "expo-updates": ">=57.0.0 <58.0.0",
    "react": "*",
    "react-native": "*"
  },
  "bin": {
    "expo-drafts": "cli/index.mjs"
  },
  "files": [
    "build",
    "src",
    "ios",
    "android",
    "cli",
    "app.plugin.js",
    "expo-module.config.json",
    "README.md",
    "LICENSE"
  ]
}
